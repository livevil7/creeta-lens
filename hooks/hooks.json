{
  "description": "Lens v3.26.0 by Creeta - dual-runtime workflows for Claude Code and Codex",
  "hooks": {
    "SessionStart": [
      {
        "once": true,
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\session-start.js\"",
            "timeout": 5000
          }
        ]
      },
      {
        "once": true,
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/sync-pull.js",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\sync-pull.js\"",
            "timeout": 90000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt-handler.js",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\scripts\\user-prompt-handler.js\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-task.js",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\pre-tool-task.js\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-task.js",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\post-tool-task.js\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/stop.js",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\stop.js\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
